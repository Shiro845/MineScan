<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MainBackground">#cccccc</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackground">#ffffff</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForeground">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="TextBlockForeground">#000000</SolidColorBrush>
</ResourceDictionary>

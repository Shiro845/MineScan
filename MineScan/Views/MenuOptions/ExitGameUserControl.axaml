<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:MineScan.ViewModels.MenuOptions"
             x:Class="MineScan.Views.MenuOptions.ExitGameUserControl" x:DataType="vm:ExitGameViewModel"
             Background="{DynamicResource MainBackground}">
             <UserControl.Styles>
                 <Style Selector="Button:pointerover /template/ ContentPresenter">
                     <Setter Property="Background" Value="{DynamicResource ButtonForeground}"/>
                     <Setter Property="Foreground" Value="{DynamicResource ButtonBackground}"/>
                 </Style>
             </UserControl.Styles>
             <Viewbox Stretch="Uniform">
                 <Panel Width="300" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                     <Border CornerRadius="10" Height="200" Background="#60606060">
                        <Grid VerticalAlignment="Center" RowDefinitions="*, 200, *">
                            <Grid Grid.Row="1" RowDefinitions="7*, 3*">
                                <TextBlock Grid.Row="0" Text="{DynamicResource YouWantLeave?}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBlockForeground}" FontSize="20"/>
                                <Grid Grid.Row="1" ColumnDefinitions="*, *">
                                    <Button Grid.Column="0" Content="{DynamicResource No}"
                                            Background="{DynamicResource ButtonBackground}"
                                            Foreground="{DynamicResource ButtonForeground}"
                                            FontSize="15"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            HorizontalAlignment="Center" Width="120" Height="33" Margin="2"
                                            Command="{Binding GoBack}"/>
                                    <Button Grid.Column="1" Content="{DynamicResource Yes}"
                                            Background="{DynamicResource ButtonBackground}"
                                            Foreground="{DynamicResource ButtonForeground}"
                                            FontSize="15"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            HorizontalAlignment="Center" Width="120" Height="33" Margin="2"
                                            Command="{Binding Exit}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                     </Border>
                 </Panel>
             </Viewbox>
</UserControl>

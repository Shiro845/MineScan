<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menuOptions="clr-namespace:MineScan.ViewModels.MenuOptions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:DataType="menuOptions:ThemesViewModel"
             x:Class="MineScan.Views.MenuOptions.ThemesUserControl"
             Background="{DynamicResource MainBackground}">
             <UserControl.Styles>
                 <Style Selector="Button:pointerover /template/ ContentPresenter">
                     <Setter Property="Background" Value="{DynamicResource ButtonForeground}"/>
                     <Setter Property="Foreground" Value="{DynamicResource ButtonBackground}"/>
                 </Style>
             </UserControl.Styles>
             <Viewbox Stretch="Uniform">
                 <Grid Width="400" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                     <Border CornerRadius="10" Height="350" Background="#60606060">
                         <Grid VerticalAlignment="Center" RowDefinitions="50, 200, 50">
                             <TextBlock Grid.Row="0" Text="{DynamicResource Themes}"
                                        Foreground="{DynamicResource TextBlockForeground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="5" FontSize="20"/>
                             <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
                             </Grid>
                             <Grid Grid.Row="1">
                                 <StackPanel VerticalAlignment="Center" 
                                             HorizontalAlignment="Center" 
                                             Spacing="15">
                 
                                     <Button Content="{DynamicResource LightTheme}"
                                             Width="200" HorizontalContentAlignment="Center"
                                             Command="{Binding SetLightTheme}"/>
                 
                                     <Button Content="{DynamicResource DarkTheme}"
                                             Width="200" HorizontalContentAlignment="Center"
                                             Command="{Binding SetDarkTheme}"/>
                 
                                     <Button Content="{DynamicResource NeonTheme}"
                                             Width="200" HorizontalContentAlignment="Center"
                                             Command="{Binding SetNeonTheme}"/>
                 
                                     <Button Content="{DynamicResource PinkTheme}"
                                             Width="200" HorizontalContentAlignment="Center"
                                             Command="{Binding SetPinkTheme}"/>
                 
                                 </StackPanel>
                             </Grid>
                             <Grid Grid.Row="2" Height="40">
                                 <Button Content="{DynamicResource Back}"
                                         Background="{DynamicResource ButtonBackground}"
                                         Foreground="{DynamicResource ButtonForeground}"
                                         FontSize="15"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         HorizontalAlignment="Center" Width="120" Margin="2" Command="{Binding GoBack}"/> 
                             </Grid>
                         </Grid>
                     </Border>
                 </Grid>
             </Viewbox>
</UserControl>

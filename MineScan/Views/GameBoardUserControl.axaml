<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MineScan.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:DataType="vm:GameBoardViewModel"
             x:Class="MineScan.Views.GameBoardUserControl">
             <Grid Background="MediumPurple">
                 <Viewbox Stretch="Uniform">
                     <Grid Width="400" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                         <Grid Background="Red" Height="300" Width="300" VerticalAlignment="Center" RowDefinitions="*, 4*, *">
                             
                         </Grid>
                     </Grid>
                 </Viewbox>
             </Grid>
</UserControl>

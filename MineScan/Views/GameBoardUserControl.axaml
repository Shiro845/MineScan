<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MineScan.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:DataType="vm:GameBoardViewModel"
             x:Class="MineScan.Views.GameBoardUserControl">
            <UserControl.Styles>
                <Style Selector="Button.Cell">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Width" Value="25"/>
                    <Setter Property="Height" Value="25"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                </Style>
                <Style Selector="Button.Cell:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
                    <Setter Property="TextBlock.Foreground" Value="{Binding $parent[Button].Foreground}"/>
                </Style>
                <Style Selector="Button.Cell.Opened">
                    <Setter Property="Background" Value="White"/>
                </Style>
                <Style Selector="Button.Cell.Mine.Opened">
                    <Setter Property="Background" Value="DarkRed"/>
                </Style>
                <Style Selector="Button.Cell.Flagged">
                    <Setter Property="Background" Value="Orange"/>
                </Style>
                <Style Selector="Button.Cell.RadarHighlight">
                    <Setter Property="Background" Value="Aqua"/>
                </Style>
            </UserControl.Styles>
            <Grid Background="{DynamicResource MainBackground}">
                 <Viewbox Stretch="Uniform">
                     <Grid Width="300" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" RowDefinitions="*, 4*, *">
                         <Button Grid.Row="0" Content="Радар" Background="PowderBlue" FontSize="15"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Center" Width="100" Margin="2" IsEnabled="{Binding !RadarUsed}"
                                 Command="{Binding RadarPingCommand}"/>
                         <Grid Grid.Row="1"  Height="300" Width="300" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform">
                                <Border CornerRadius="5" BorderBrush="Black" BorderThickness="5">
                                    <ItemsControl Name="ItemsControl" Background="DarkSlateGray" ItemsSource="{Binding Cells}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </ItemsPanelTemplate> 
                                        </ItemsControl.ItemsPanel>
                                        
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding #ItemsControl.((vm:GameBoardViewModel)DataContext).OpenCellCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="Cell"
                                                        Classes.Opened="{Binding IsOpen}"
                                                        Classes.Mine="{Binding IsMine}"
                                                        Classes.Flagged="{Binding IsFlagged}"
                                                        Classes.RadarHighlight="{Binding IsRadarScanning}">
                                                <Interaction.Behaviors>
                                                    <EventTriggerBehavior EventName="RightTapped">
                                                        <InvokeCommandAction 
                                                            Command="{Binding #ItemsControl.((vm:GameBoardViewModel)DataContext).FlagCellCommand}"
                                                            CommandParameter="{Binding}" />
                                                    </EventTriggerBehavior>
                                                </Interaction.Behaviors>
                                                    <Viewbox Stretch="Uniform">
                                                        <Panel>
                                                            <Panel IsVisible="{Binding IsOpen}">
                                                                <TextBlock Text="{Binding MinesAroundText}"
                                                                       Foreground="{Binding NumberColor}"/>
                                                                <Image Source="/Assets/Images/bomb.png"
                                                                   Stretch="Fill"
                                                                   IsVisible="{Binding IsMine}">
                                                                </Image>
                                                            </Panel>
                                                            <Image Source="/Assets/Images/flag.png"
                                                                   Stretch="Fill"
                                                                   IsVisible="{Binding IsFlagged}">
                                                            </Image>
                                                        </Panel>
                                                    </Viewbox>
                                                </Button> 
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Viewbox>
                            <Viewbox Stretch="Uniform">
                                    <Border CornerRadius="5" 
                                            Height="200" Width="200"
                                            Background="#c2606060"
                                            IsVisible="{Binding Lose}">
                                            <Grid>
                                                    <TextBlock Foreground="White"
                                                               Text="You Lose"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="30"/>
                                            </Grid>
                                    </Border>
                            </Viewbox>
                            <Viewbox Stretch="Uniform">
                                <Border CornerRadius="5" 
                                        Height="200" Width="200"
                                        Background="#c2606060"
                                        IsVisible="{Binding Win}">
                                    <Grid>
                                        <TextBlock Foreground="White"
                                                   Text="You Win"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="30"/>
                                    </Grid>
                                </Border>
                            </Viewbox>
                         </Grid>
                         <Grid Grid.Row="2" ColumnDefinitions="*, *">
                             <Button Grid.Column="0" Content="Меню" Background="PowderBlue" FontSize="15"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     HorizontalAlignment="Right" Width="100" Margin="2" Command="{Binding GoBack}"/> 
                             <Button Grid.Column="1" Content="Заново" Background="PowderBlue" FontSize="15"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left" Width="100" Margin="2" Command="{Binding Restart}"/>
                         </Grid>
                     </Grid>
                 </Viewbox>
             </Grid>
</UserControl>
